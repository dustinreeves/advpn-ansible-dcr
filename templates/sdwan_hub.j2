config system zone
    edit "Data"
        set interface "{{ lan.interface }}"
    next
end

config system sdwan
    set status enable

    config zone
        edit "virtual-wan-link"
        next
        edit "inet"
        next
        edit "vpnsdwan"
        next
    end

    config members
{% for t in hub_overlay_interfaces %}
        edit {{ t.member_id }}
            set interface "{{ t.name }}"
            set zone "vpnsdwan"
        next
{% endfor %}
        edit {{ hub_overlay_interfaces | map(attribute='member_id') | max + 1 }}
            set interface "{{ wan.wan2.interface }}"
            set zone "inet"
            set gateway 100.65.0.1
        next
        edit {{ hub_overlay_interfaces | map(attribute='member_id') | max + 2 }}
            set interface "{{ wan.wan1.interface }}"
            set zone "inet"
            set gateway 100.64.0.1
        next
    end

{% if hub_sdwan_health_checks is defined and (hub_sdwan_health_checks | length > 0) %}
    config health-check
{% for hc in hub_sdwan_health_checks %}
        edit "{{ hc.name }}"
            set server "{{ hc.server }}"
{% if hc.source is defined %}
            set source {{ hc.source }}
{% endif %}
{% if hc.detect_mode is defined %}
            set detect-mode {{ hc.detect_mode }}
{% endif %}
            set members {{ hc.members | join(' ') }}
            config sla
                edit 1
                    set packetloss-threshold {{ hc.packetloss_threshold }}
                next
            end
        next
{% endfor %}
    end
{% endif %}

    config service
        edit 1
            set name "{{ hub_sdwan_inet_service.name }}"
            set dst "{{ hub_sdwan_inet_service.dst }}"
            set dst-negate {{ hub_sdwan_inet_service.dst_negate }}
            set src "{{ hub_sdwan_inet_service.src }}"
            set priority-members {{ hub_overlay_interfaces | map(attribute='member_id') | max + 1 }} {{ hub_overlay_interfaces | map(attribute='member_id') | max + 2 }}
            set priority-zone "inet"
        next
{% for svc in hub_sdwan_route_services | default([], true) %}
        edit {{ 50 + loop.index }}
            set name "{{ svc.name }}"
            set route-tag {{ svc.route_tag }}
            set src "{{ svc.src | default('rfc1918grp') }}"
            set mode {{ svc.mode | default('manual') }}
{% if svc.tie_break is defined %}
            set tie-break {{ svc.tie_break }}
{% endif %}
            set priority-members {{ svc.priority_members | join(' ') }}
        next
{% endfor %}
    end
end

config firewall policy
    edit 0
        set name "allow-all-trusted"
        set srcintf "{{ lo_bgp.interface }}" "{{ lo_hc.interface }}" "vpnsdwan" "Data"
        set dstintf "vpnsdwan" "{{ lo_bgp.interface }}" "{{ lo_hc.interface }}" "Data"
        set action accept
        set srcaddr "all"
        set dstaddr "all"
        set schedule "always"
        set service "ALL"
    next
    edit 0
        set name "Data-to-inet"
        set srcintf "Data" "{{ lo_bgp.interface }}" "{{ lo_hc.interface }}"
        set dstintf "inet"
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
        set nat enable
    next
end

config router static
    edit 1
        set distance 1
        set sdwan-zone "inet"
    next
end
