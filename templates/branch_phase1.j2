config vpn ipsec phase1-interface
{% for t in tunnel_matrix %}
    edit "{{ t.name }}"
        set interface "{{ wan[t.branch_wan].interface }}"
        set ike-version {{ ike_version }}
        set peertype any
        set net-device {{ net_device }}
{% if bgp.session_mode == "loopback" %}
        set exchange-interface-ip enable
        set exchange-ip-addr4 {{ lo_bgp.ip.split()[0] }}
{% else %}
        set mode-cfg {{ mode_cfg }}
{% endif %}
        set proposal {{ proposal }}
        set add-route {{ add_route }}
        set localid "{{ site_slug }}-{{ t.network_id }}"
        set dhgrp {{ dhgrp }}
        set auto-discovery-receiver {{ auto_discovery_receiver }}
        set auto-discovery-shortcuts {{ auto_discovery_shortcuts }}
        set network-overlay {{ network_overlay }}
        set network-id {{ t.network_id }}
        set remote-gw {{ hubs[t.hub][t.hub_wan ~ '_gw'] }}
        set psksecret {{ psksecret }}
    next
{% endfor %}
end
